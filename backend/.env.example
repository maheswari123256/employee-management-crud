# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ---- MongoDB ----
MONGO_URI=mongodb://127.0.0.1:27017/wizinoa_erp

# ---- Auth (JWT) ----
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ---- Seeded admin account (only admin can create employees) ----
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@wizinoa.com
ADMIN_PASSWORD=Admin@123

# ---- Seed demo employees when the collection is empty (set false to disable) ----
SEED_DEMO_DATA=true
